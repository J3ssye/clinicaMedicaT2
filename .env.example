APP_NAME=clinica-chatbot
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=troque-esta-chave
WEBHOOK_HMAC_SECRET=troque-esta-chave
REQUIRE_WEBHOOK_SIGNATURE=false
API_RATE_LIMIT_PER_MINUTE=60
MAX_MESSAGE_AGE_SECONDS=300

POSTGRES_DB=clinica
POSTGRES_USER=clinica
POSTGRES_PASSWORD=clinica
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://clinica:clinica@postgres:5432/clinica

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

WAHA_BASE_URL=http://waha:3000
WAHA_SESSION=default
WAHA_API_KEY=troque-esta-chave
WAHA_MARK_AS_SEEN_BEFORE_REPLY=true
WAHA_IGNORE_GROUP_MESSAGES=true
WAHA_IGNORE_STATUS_MESSAGES=true
WAHA_IGNORE_OWN_MESSAGES=false
WAHA_PROCESS_EVENTS=message.any
WAHA_MESSAGE_SOFT_LIMIT=3200
WAHA_MESSAGE_HARD_LIMIT=3900
WAHA_CHUNK_DELAY_MS=350
WAHA_DASHBOARD_USERNAME=clinicadmin
WAHA_DASHBOARD_PASSWORD=troque-esta-senha
WHATSAPP_SWAGGER_USERNAME=clinicadmin
WHATSAPP_SWAGGER_PASSWORD=troque-esta-senha

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_AUDIO_MODEL=gpt-4o-mini-transcribe
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
LLM_PROVIDER_ORDER=gemini,openai,anthropic
LLM_HTTP_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=1800
LLM_CLASSIFY_MAX_OUTPUT_TOKENS=16
LLM_HISTORY_MAX_MESSAGES=12
LLM_ENABLE_CLASSIFICATION_FALLBACK=false
LLM_ENABLE_FAQ_GENERATION_FALLBACK=true
FAQ_CACHE_TTL_SECONDS=900
CONVERSATION_MEMORY_TTL_SECONDS=21600
CONVERSATION_MEMORY_HISTORY_LIMIT=40

CLINIC_ASSISTANT_SYSTEM_PROMPT=Você é a assistente virtual de uma clínica médica. Atenda pacientes em português do Brasil com linguagem clara, educada e objetiva. Nunca invente diagnósticos, resultados, horários ou promessas em nome da clínica. Quando faltar informação operacional, diga que a equipe pode confirmar.
CLINIC_SECRETARY_NAME=Malu
CLINIC_NAME=Clínica Médica Valéria Frota
CLINIC_COMPANY_NAME=FIDEM
CLINIC_ADDRESS=Setor Aeroporto, Rua 9A, 160, Goiânia - GO
CLINIC_TIMEZONE=America/Sao_Paulo
DEFAULT_APPOINTMENT_DURATION_MINUTES=30
AI_HUMAN_PAUSE_HOURS=3

GOOGLE_CALENDAR_ID=coloque-aqui-o-id-do-calendario@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_REVIEW_LINK=
GOOGLE_REVIEW_LINK_VITORIA=
GOOGLE_REVIEW_LINK_LUCAS=

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=clinica-documentos
MINIO_SECURE=false

FAQ_KB_PATH=app/data/faq.md
